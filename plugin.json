{
  "id": "languages",
  "name": "%plugin.name%",
  "version": "0.1.0",
  "vendor": "Lemon Paperplane",
  "description": "%plugin.description%",
  "icon": "icons/languages.svg",
  "category": "tool",
  "engines": {"paperplane": ">=0.1.0 <0.2.0"},
  "protocol": 1,
  "activation": {},
  "contributes": {
    "languages": [
      {"id": "markdown", "name": "Markdown", "extensions": [".md", ".markdown", ".mdown", ".mkd", ".mdx"], "module": "editor/lang-markdown.js", "blockComment": ["<!--", "-->"]},
      {"id": "yaml", "name": "YAML", "extensions": [".yaml", ".yml"], "filenames": [".clang-format", ".clang-tidy", ".gemrc"], "module": "editor/lang-yaml.js", "lineComment": "#"},
      {"id": "xml", "name": "XML", "extensions": [".xml", ".xsd", ".xsl", ".xslt", ".svg", ".plist", ".wsdl", ".fxml", ".xaml", ".csproj", ".vbproj", ".fsproj", ".props", ".targets", ".resx", ".iml", ".storyboard", ".xib", ".kml", ".gpx", ".rss", ".atom", ".tld", ".jnlp", ".nuspec", ".config"], "filenames": ["pom.xml"], "module": "editor/lang-xml.js", "blockComment": ["<!--", "-->"]},
      {"id": "html", "name": "HTML", "extensions": [".html", ".htm", ".xhtml", ".shtml"], "module": "editor/lang-html.js", "blockComment": ["<!--", "-->"]},
      {"id": "css", "name": "CSS", "extensions": [".css", ".wxss", ".acss"], "module": "editor/lang-css.js", "blockComment": ["/*", "*/"]},
      {"id": "scss", "name": "SCSS", "extensions": [".scss"], "module": "editor/lang-scss.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "sass", "name": "Sass", "extensions": [".sass"], "module": "editor/lang-sass.js", "lineComment": "//"},
      {"id": "less", "name": "Less", "extensions": [".less"], "module": "editor/lang-less.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "shell", "name": "Shell", "extensions": [".sh", ".bash", ".zsh", ".ksh", ".command"], "filenames": [".bashrc", ".bash_profile", ".bash_login", ".bash_logout", ".bash_aliases", ".profile", ".zshrc", ".zshenv", ".zprofile", ".zlogin", ".zlogout", ".envrc", "gradlew", "mvnw", "PKGBUILD"], "module": "editor/lang-shell.js", "lineComment": "#"},
      {"id": "sql", "name": "SQL", "extensions": [".sql", ".ddl", ".dml", ".pgsql", ".psql", ".mysql"], "module": "editor/lang-sql.js", "lineComment": "--", "blockComment": ["/*", "*/"]},
      {"id": "dockerfile", "name": "Dockerfile", "extensions": [".dockerfile"], "filenames": ["Dockerfile", "dockerfile", "Containerfile"], "filenamePatterns": ["Dockerfile.*", "*.Dockerfile", "Containerfile.*"], "module": "editor/lang-dockerfile.js", "lineComment": "#"},
      {"id": "toml", "name": "TOML", "extensions": [".toml"], "filenames": ["Pipfile", "Cargo.lock", "poetry.lock", "uv.lock", "pdm.lock"], "module": "editor/lang-toml.js", "lineComment": "#"},
      {"id": "properties", "name": "Properties", "extensions": [".properties"], "module": "editor/lang-properties.js", "lineComment": "#"},
      {"id": "ini", "name": "INI", "extensions": [".ini", ".cfg", ".conf", ".cnf", ".inf", ".reg"], "filenames": [".editorconfig", ".npmrc", ".yarnrc", ".pypirc", ".flake8", ".pylintrc", ".coveragerc", "setup.cfg", "tox.ini", "pip.conf", "my.cnf"], "module": "editor/lang-properties.js", "lineComment": "#"},
      {"id": "dotenv", "name": "Dotenv", "extensions": [".env"], "filenames": [".env"], "filenamePatterns": [".env.*", "*.env"], "module": "editor/lang-properties.js", "lineComment": "#"},
      {"id": "makefile", "name": "Makefile", "extensions": [".mk", ".mak", ".make"], "filenames": ["Makefile", "makefile", "GNUmakefile"], "module": "editor/lang-makefile.js", "lineComment": "#"},
      {"id": "nginx", "name": "Nginx", "extensions": [".nginx", ".nginxconf"], "filenames": ["nginx.conf"], "filenamePatterns": ["nginx*.conf", "*.nginx.conf"], "module": "editor/lang-nginx.js", "lineComment": "#"},
      {"id": "protobuf", "name": "Protocol Buffers", "extensions": [".proto"], "module": "editor/lang-protobuf.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "rust", "name": "Rust", "extensions": [".rs"], "module": "editor/lang-rust.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "cpp", "name": "C/C++", "extensions": [".c", ".h", ".cc", ".cpp", ".cxx", ".c++", ".hpp", ".hh", ".hxx", ".h++", ".ipp", ".inl", ".ino", ".cu", ".cuh"], "module": "editor/lang-cpp.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "csharp", "name": "C#", "extensions": [".cs", ".csx"], "module": "editor/lang-csharp.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "swift", "name": "Swift", "extensions": [".swift"], "module": "editor/lang-swift.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "php", "name": "PHP", "extensions": [".php", ".phtml", ".php3", ".php4", ".php5", ".phps"], "module": "editor/lang-php.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "ruby", "name": "Ruby", "extensions": [".rb", ".rake", ".gemspec", ".ru", ".podspec"], "filenames": ["Gemfile", "Rakefile", "Podfile", "Fastfile", "Appfile", "Matchfile", "Brewfile", "Vagrantfile", "Guardfile", "Dangerfile", ".pryrc", ".irbrc"], "module": "editor/lang-ruby.js", "lineComment": "#"},
      {"id": "lua", "name": "Lua", "extensions": [".lua"], "module": "editor/lang-lua.js", "lineComment": "--", "blockComment": ["--[[", "]]"]},
      {"id": "dart", "name": "Dart", "extensions": [".dart"], "module": "editor/lang-dart.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "scala", "name": "Scala", "extensions": [".scala", ".sc", ".sbt"], "module": "editor/lang-scala.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "objective-c", "name": "Objective-C", "extensions": [".m", ".mm"], "module": "editor/lang-objectivec.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "perl", "name": "Perl", "extensions": [".pl", ".pm", ".psgi"], "module": "editor/lang-perl.js", "lineComment": "#"},
      {"id": "powershell", "name": "PowerShell", "extensions": [".ps1", ".psm1", ".psd1"], "module": "editor/lang-powershell.js", "lineComment": "#", "blockComment": ["<#", "#>"]},
      {"id": "r", "name": "R", "extensions": [".r"], "filenames": [".Rprofile"], "module": "editor/lang-r.js", "lineComment": "#"},
      {"id": "cmake", "name": "CMake", "extensions": [".cmake"], "filenames": ["CMakeLists.txt"], "module": "editor/lang-cmake.js", "lineComment": "#"},
      {"id": "haskell", "name": "Haskell", "extensions": [".hs", ".lhs"], "module": "editor/lang-haskell.js", "lineComment": "--", "blockComment": ["{-", "-}"]},
      {"id": "clojure", "name": "Clojure", "extensions": [".clj", ".cljs", ".cljc", ".edn"], "module": "editor/lang-clojure.js", "lineComment": ";"},
      {"id": "erlang", "name": "Erlang", "extensions": [".erl", ".hrl"], "filenames": ["rebar.config"], "module": "editor/lang-erlang.js", "lineComment": "%"},
      {"id": "julia", "name": "Julia", "extensions": [".jl"], "module": "editor/lang-julia.js", "lineComment": "#", "blockComment": ["#=", "=#"]},
      {"id": "http", "name": "HTTP", "extensions": [".http", ".rest"], "module": "editor/lang-http.js", "lineComment": "#"},
      {"id": "vb", "name": "Visual Basic", "extensions": [".vb", ".bas", ".vbs"], "module": "editor/lang-vb.js", "lineComment": "'"},
      {"id": "pascal", "name": "Pascal", "extensions": [".pas", ".pp", ".dpr", ".lpr"], "module": "editor/lang-pascal.js", "lineComment": "//", "blockComment": ["{", "}"]},
      {"id": "fortran", "name": "Fortran", "extensions": [".f", ".for", ".f90", ".f95", ".f03", ".f08"], "module": "editor/lang-fortran.js", "lineComment": "!"},
      {"id": "verilog", "name": "Verilog", "extensions": [".v", ".sv", ".svh", ".vh"], "module": "editor/lang-verilog.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "vhdl", "name": "VHDL", "extensions": [".vhd", ".vhdl"], "module": "editor/lang-vhdl.js", "lineComment": "--"},
      {"id": "tcl", "name": "Tcl", "extensions": [".tcl", ".tk"], "module": "editor/lang-tcl.js", "lineComment": "#"},
      {"id": "elm", "name": "Elm", "extensions": [".elm"], "module": "editor/lang-elm.js", "lineComment": "--", "blockComment": ["{-", "-}"]},
      {"id": "crystal", "name": "Crystal", "extensions": [".cr"], "module": "editor/lang-crystal.js", "lineComment": "#"},
      {"id": "d", "name": "D", "extensions": [".d", ".di"], "module": "editor/lang-d.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "coffeescript", "name": "CoffeeScript", "extensions": [".coffee", ".cson"], "module": "editor/lang-coffeescript.js", "lineComment": "#", "blockComment": ["###", "###"]},
      {"id": "pug", "name": "Pug", "extensions": [".pug", ".jade"], "module": "editor/lang-pug.js", "lineComment": "//-"},
      {"id": "stylus", "name": "Stylus", "extensions": [".styl", ".stylus"], "module": "editor/lang-stylus.js", "lineComment": "//", "blockComment": ["/*", "*/"]},
      {"id": "gherkin", "name": "Gherkin", "extensions": [".feature"], "module": "editor/lang-gherkin.js", "lineComment": "#"},
      {"id": "puppet", "name": "Puppet", "extensions": [".epp"], "filenames": ["Puppetfile"], "module": "editor/lang-puppet.js", "lineComment": "#"},
      {"id": "latex", "name": "LaTeX", "extensions": [".tex", ".sty", ".cls", ".ltx", ".bib"], "module": "editor/lang-latex.js", "lineComment": "%"},
      {"id": "jinja", "name": "Jinja", "extensions": [".j2", ".jinja", ".jinja2"], "module": "editor/lang-jinja2.js", "blockComment": ["{#", "#}"]},
      {"id": "nsis", "name": "NSIS", "extensions": [".nsi", ".nsh"], "module": "editor/lang-nsis.js", "lineComment": ";", "blockComment": ["/*", "*/"]}
    ]
  }
}
